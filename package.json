{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "Cryptographically Verifiable Agent-to-Agent Checkout Pipeline for UAP and Razorpay",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "demo": "tsx src/demo.ts",
    "demo:cool": "tsx scripts/cool-demo.ts",
    "chaos": "tsx scripts/chaos-fuzzer.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "agentic-commerce",
    "did",
    "verifiable-credentials",
    "razorpay",
    "uap",
    "upi-reserve-pay",
    "ed25519",
    "x25519",
    "ecdh",
    "zero-trust"
  ],
  "author": "AgentPay Engineering",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "cool-nwc": "^3.1.1",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.6",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
