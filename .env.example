# AgentPay Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Razorpay Test Mode Credentials (Optional - Mock Gateway used if omitted)
# 1. Sign up at https://dashboard.razorpay.com → Settings → API Keys → Generate Test Key
# 2. Paste the rzp_test_... key id + secret below
# 3. Set RAZORPAY_MOCK_MODE=false to use the live test-mode Orders API
RAZORPAY_KEY_ID=rzp_test_agentpay_mock
RAZORPAY_KEY_SECRET=agentpay_secret_test_mock_12345
RAZORPAY_MOCK_MODE=true

# Razorpay Webhooks (live settlement confirmations)
# 1. Dashboard → Settings → Webhooks → Add New Webhook
# 2. URL: https://<your-host>/api/webhooks/razorpay  (use ngrok for local dev:
#    `ngrok http 3000` then paste the https URL)
# 3. Active events: payment.captured, payment.failed
# 4. Set a secret (any strong random string) and paste the SAME value below —
#    deliveries are HMAC-SHA256 verified against it in constant time.
RAZORPAY_WEBHOOK_SECRET=

# Agent Network Settings
MERCHANT_DID_NAME=AgentPay Cloud Services
MERCHANT_PORT=3000

# LLM Strategy Layer (Optional - Deterministic strategies used if disabled/unset)
# Preferred demo order: OpenRouter FIRST, Gemini fallback, deterministic last.
# OpenRouter: https://openrouter.ai/keys  |  Gemini: https://aistudio.google.com/apikey
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_MS=15000   # lower to 12000 while recording: slow providers fail over faster

# Durable ledger (Priority 5) - SQLite via node:sqlite, memory fallback
PERSISTENCE=auto          # auto | memory
SQLITE_PATH=./agentpay.db
